# ---------------------------------------------------------------------------
# Supabase
# Project settings -> API in the Supabase dashboard.
# ---------------------------------------------------------------------------

# Safe to expose to the browser. Row level security governs what it can read.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses row level security completely.
# Never prefix this with NEXT_PUBLIC_, never import it into a client component,
# and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Used for canonical URLs, the sitemap, OG images and auth redirect links.
NEXT_PUBLIC_SITE_URL=https://workrotighar.com

# ---------------------------------------------------------------------------
# secrets — never commit these
# Contains NEXT_PUBLIC_SUPABASE_URL / ANON_KEY and, critically, the
# SUPABASE_SERVICE_ROLE_KEY, which bypasses row level security.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
service-account*.json

